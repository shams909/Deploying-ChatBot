[Unit]
Description=LabAI Tier 1 Inference (Qwen3-4B Fast)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cluster
Group=cluster
# One logical thread per physical P-core (Cores 0-7 = CPUs 0,2,4,6,8,10,12,14)
CPUAffinity=0 2 4 6 8 10 12 14
Nice=-5
ExecStart=/opt/llama.cpp/build/bin/llama-server \
  --model /opt/labai/models/Qwen3-4B-Q4_K_M.gguf \
  --alias labai-fast \
  --host 0.0.0.0 \
  --port 8081 \
  --threads 8 \
  --threads-batch 8 \
  --ctx-size 8192 \
  --parallel 2 \
  --flash-attn on \
  --cache-type-k q8_0 \
  --cache-type-v q8_0 \
  --cache-reuse 256 \
  --metrics
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
